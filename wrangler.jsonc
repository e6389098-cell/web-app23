{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app23",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "389fcf59-1a1c-499f-b4c5-c4bdf0fa8677","database_name": "web-app23" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "1700c4947e75476c97044298f7f3719c" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
